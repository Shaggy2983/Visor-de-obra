{
  "appId": "do.coordinate.visorobra",
  "appName": "CRD Obra",
  "webDir": "app",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#121826",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
