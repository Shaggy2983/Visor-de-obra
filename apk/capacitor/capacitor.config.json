{
  "appId": "com.grupoaqua.e04visor",
  "appName": "E04 3D",
  "webDir": "app",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#12161a",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
